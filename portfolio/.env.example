# Copy this file to ".env" and fill in the two values from your Supabase project
# (Supabase dashboard > Project Settings > API).
# Both values are safe to expose in the browser: access is controlled by the
# row-level security rules in supabase/schema.sql.
#
# Leave them empty to run in demo mode (data saved only in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Brevo API key is NOT set here. It is stored as a Supabase secret and used
# only by the "contact" edge function, so it never reaches the browser:
#   supabase secrets set BREVO_API_KEY=... BREVO_SENDER_EMAIL=... CONTACT_TO_EMAIL=...
